# ── Database ───────────────────────────────────────────────────────────────
# Postgres superuser — internal only, not used by apps
DB_ADMIN_PASSWORD=changeme_use_a_strong_password
# Per-app credentials (each user only has access to its own database)
IMMICH_DB_PASSWORD=changeme_use_a_strong_password
EVOLUTION_DB_PASSWORD=changeme_use_a_strong_password

# ── Immich ─────────────────────────────────────────────────────────────────
IMMICH_VERSION=release
UPLOAD_LOCATION=./photos-local-dev
# Set this after first login to Immich (Settings → API Keys)
IMMICH_API_KEY=

# ── Evolution API ──────────────────────────────────────────────────────────
EVOLUTION_API_KEY=changeme_use_a_strong_key

# ── photos_to_frame_daemon ─────────────────────────────────────────────────
# Set to DEBUG to see full webhook payloads and Immich API responses
LOG_LEVEL=INFO
IMMICH_ALBUM_NAME=Grandma's Frame
# WhatsApp group JID to accept photos from, e.g. 1234567890-1234567890@g.us
# Leave empty to accept from all chats.
WHATSAPP_GROUP_ID=
