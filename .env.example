# ── Database ───────────────────────────────────────────────────────────────
# Postgres superuser — internal only, not used by apps
DB_ADMIN_PASSWORD=changeme_use_a_strong_password
# Per-app credentials (each user only has access to its own database)
IMMICH_DB_PASSWORD=changeme_use_a_strong_password
EVOLUTION_DB_PASSWORD=changeme_use_a_strong_password

# ── Immich ─────────────────────────────────────────────────────────────────
IMMICH_VERSION=release
UPLOAD_LOCATION=./photos-local-dev
# Set this after first login to Immich (Settings → API Keys)
IMMICH_API_KEY=

# ── Evolution API ──────────────────────────────────────────────────────────
EVOLUTION_API_KEY=changeme_use_a_strong_key
# Instance name for the service bot account used by backfill.py.
# Set to the instanceName you choose when creating the instance. See backfill.md.
USER_BACKFILL_EVOLUTION_INSTANCE_NAME=

# ── ImmichFrame ─────────────────────────────────────────────────────────────
# API key for the frame display — create on the frame-bot service account (not admin),
# so the frame can only access albums shared with the bot (natural album scoping)
IMMICH_FRAME_API_KEY=

# ── Tailscale (production only) ────────────────────────────────────────────
# Auth key from https://login.tailscale.com/admin/settings/keys
# Use a pre-authorized, reusable (NOT ephemeral) key so the device persists across restarts.
TS_AUTHKEY=tskey-auth-...

# ── photos_to_frame_daemon ─────────────────────────────────────────────────
# Set to DEBUG to see full webhook payloads and Immich API responses
LOG_LEVEL=INFO
IMMICH_ALBUM_ID=
# WhatsApp group JID to accept photos from, e.g. 1234567890-1234567890@g.us
# Leave empty to accept from all chats.
WHATSAPP_GROUP_ID=
